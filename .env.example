# FLEXT gRPC Service Configuration
# Copy this to .env and customize for your environment

DEBUG=true
# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# gRPC Server Configuration
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
MAX_MESSAGE_SIZE=4194304
MAX_WORKERS=10

SERVER_CREDENTIALS=
TLS_CERT_FILE=
# Security
TLS_ENABLED=false
TLS_KEY_FILE=

DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_SIZE=20
# Database
DATABASE_URL=postgresql://flext:password@localhost:5432/flext_grpc

REDIS_MAX_CONNECTIONS=50
# Redis Cache
REDIS_URL=redis://localhost:6379/1

METRICS_PORT=9091
OPENTELEMETRY_ENABLED=false
# Monitoring & Observability
PROMETHEUS_ENABLED=true
SENTRY_DSN=

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_SERVICE=flext-grpc

# External Services
FLEXT_API_URL=http://localhost:8000
FLEXT_WEB_URL=http://localhost:8080

# Connection Timeouts
CONNECTION_TIMEOUT=30
KEEPALIVE_PERMIT_WITHOUT_CALLS=true
KEEPALIVE_TIME=30
KEEPALIVE_TIMEOUT=5

# Reflection (for development)
REFLECTION_ENABLED=true
