@startuml FLEXT-gRPC Component Diagram
!include <C4/C4_Component>

title FLEXT-gRPC Component Diagram

Container_Boundary(flext_grpc_lib, "FLEXT-gRPC Library") {
    Component(flext_grpc_api, "API Layer", "Python", "Public API facade and factory functions")
    Component(flext_grpc_services, "Service Layer", "Python", "Business logic orchestration and service coordination")
    Component(flext_grpc_entities, "Domain Entities", "Python", "Core business entities and state machines")
    Component(flext_grpc_config, "Configuration", "Python", "Configuration management and validation")
    Component(flext_grpc_exceptions, "Exception Hierarchy", "Python", "Typed exception classes and error handling")
    Component(flext_grpc_utilities, "Utilities", "Python", "Helper functions and utilities")
    Component(flext_grpc_protobuf, "Protocol Buffers", "Generated Python", "Generated message and service classes")
}

Container_Boundary(flext_core, "FLEXT-Core") {
    Component(flext_result, "FlextResult[T]", "Railway Pattern", "Functional error handling")
    Component(flext_container, "FlextContainer", "Dependency Injection", "Service registration and resolution")
    Component(flext_service, "FlextService", "Service Pattern", "Base service class with lifecycle")
    Component(flext_logger, "FlextLogger", "Structured Logging", "Consistent logging interface")
}

Container_Boundary(flext_observability, "FLEXT-Observability") {
    Component(metrics_collector, "Metrics Collector", "Prometheus", "Performance and health metrics")
    Component(tracer, "Distributed Tracer", "OpenTelemetry", "Request tracing and correlation")
    Component(health_checker, "Health Checker", "HTTP/gRPC", "Service health monitoring")
}

System_Ext(grpcio_runtime, "grpcio Runtime", "gRPC protocol implementation")
System_Ext(protobuf_runtime, "Protobuf Runtime", "Message serialization")

Rel(flext_grpc_api, flext_grpc_services, "Orchestrates", "Business logic coordination")
Rel(flext_grpc_api, flext_grpc_entities, "Creates", "Entity instantiation")
Rel(flext_grpc_api, flext_grpc_config, "Reads", "Configuration data")

Rel(flext_grpc_services, flext_grpc_entities, "Uses", "Domain object manipulation")
Rel(flext_grpc_services, flext_grpc_exceptions, "Raises", "Error conditions")
Rel(flext_grpc_services, flext_grpc_utilities, "Uses", "Helper functions")

Rel(flext_grpc_entities, flext_grpc_protobuf, "Uses", "Message serialization")

Rel(flext_grpc_api, flext_result, "Returns", "Railway pattern results")
Rel(flext_grpc_services, flext_container, "Resolves", "Dependency injection")
Rel(flext_grpc_services, flext_service, "Extends", "Service lifecycle")
Rel(flext_grpc_services, flext_logger, "Uses", "Structured logging")

Rel(flext_grpc_services, metrics_collector, "Reports to", "Performance metrics")
Rel(flext_grpc_services, tracer, "Creates spans", "Request tracing")
Rel(flext_grpc_services, health_checker, "Registers", "Health status")

Rel(flext_grpc_entities, grpcio_runtime, "Uses", "gRPC protocol")
Rel(flext_grpc_protobuf, protobuf_runtime, "Uses", "Message serialization")

@enduml
