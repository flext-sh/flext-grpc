{
  "system": {
    "version": "1.0.0",
    "name": "FLEXT-gRPC Documentation Maintenance Framework",
    "description": "Comprehensive documentation quality assurance and maintenance system"
  },
  "audit": {
    "enabled": true,
    "file_patterns": ["*.md", "*.mdx"],
    "exclude_dirs": [".git", "node_modules", "__pycache__", ".venv", "docs/maintenance"],
    "quality_thresholds": {
      "excellent": 90,
      "good": 80,
      "needs_work": 70,
      "critical": 0
    },
    "freshness_threshold_days": 30,
    "min_word_count": 50,
    "max_word_count": 5000,
    "max_file_size_kb": 1024
  },
  "validation": {
    "enabled": true,
    "check_external_links": true,
    "check_internal_links": true,
    "check_images": true,
    "link_timeout": 10,
    "max_concurrent_checks": 5,
    "retry_failed_links": 2,
    "ignore_patterns": [
      "localhost",
      "127.0.0.1",
      "*.local",
      "example.com"
    ]
  },
  "style": {
    "enabled": true,
    "max_line_length": 88,
    "heading_hierarchy": true,
    "list_consistency": true,
    "code_block_languages": true,
    "emphasis_consistency": true,
    "required_frontmatter": ["title"],
    "heading_style": "atx"
  },
  "optimization": {
    "enabled": true,
    "auto_fix_formatting": true,
    "generate_toc": true,
    "update_metadata": true,
    "fix_common_issues": true,
    "max_toc_depth": 3,
    "toc_min_headings": 4,
    "add_missing_alt_text": true,
    "normalize_emphasis": true
  },
  "sync": {
    "enabled": true,
    "auto_commit": true,
    "create_backup_branch": true,
    "commit_message_template": "docs: {action} documentation\n\n{details}\n\nQuality Score: {quality_score}%",
    "branch_prefix": "docs-maintenance",
    "conflict_resolution": "manual",
    "track_changes": true
  },
  "reporting": {
    "enabled": true,
    "generate_html_dashboard": true,
    "generate_csv_reports": true,
    "generate_trend_analysis": true,
    "report_retention_days": 90,
    "alert_on_critical": true,
    "alert_on_score_drop": true,
    "score_drop_threshold": 5
  },
  "automation": {
    "enabled": true,
    "schedule_maintenance": "daily",
    "schedule_audit": "daily",
    "schedule_validation": "weekly",
    "schedule_optimization": "weekly",
    "schedule_backup": "daily",
    "auto_fix_enabled": true,
    "notification_enabled": false
  },
  "notifications": {
    "enabled": false,
    "slack_webhook": null,
    "email_recipients": [],
    "notify_on_critical": true,
    "notify_on_warnings": false,
    "notify_on_score_changes": true
  },
  "performance": {
    "cache_enabled": true,
    "cache_ttl_hours": 24,
    "parallel_processing": true,
    "max_workers": 4,
    "timeout_seconds": 300
  },
  "logging": {
    "enabled": true,
    "level": "INFO",
    "log_to_file": true,
    "log_directory": "docs/maintenance/logs",
    "max_log_size_mb": 10,
    "max_log_files": 5
  },
  "custom_rules": {
    "project_specific": {
      "required_sections": ["Overview", "Installation", "Usage", "API"],
      "forbidden_terms": ["TODO", "FIXME", "HACK"],
      "required_metadata": ["title", "last_updated"],
      "code_languages": ["python", "bash", "json", "yaml"]
    },
    "quality_checks": {
      "min_sentences_per_paragraph": 1,
      "max_headings_per_section": 10,
      "require_examples": true,
      "check_cross_references": true
    }
  },
  "integrations": {
    "github": {
      "enabled": false,
      "token": null,
      "repository": "flext/flext-grpc",
      "create_issues": false,
      "create_pull_requests": false
    },
    "slack": {
      "enabled": false,
      "webhook_url": null,
      "channels": ["#documentation", "#devops"],
      "notify_schedule": "weekly"
    },
    "jira": {
      "enabled": false,
      "server_url": null,
      "project_key": null,
      "issue_type": "Task",
      "auto_create_tickets": false
    }
  },
  "advanced": {
    "experimental_features": false,
    "debug_mode": false,
    "verbose_logging": false,
    "custom_plugins": [],
    "external_tools": {
      "markdown_lint": false,
      "alex": false,
      "write_good": false
    }
  }
}