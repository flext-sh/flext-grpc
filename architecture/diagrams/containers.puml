@startuml FLEXT-gRPC Container Diagram
!include <C4/C4_Container>

title FLEXT-gRPC Container Diagram

Person(user, "FLEXT Developer", "Python developer using FLEXT ecosystem")

System_Boundary(flext_grpc_system, "FLEXT-gRPC System") {
    Container(flext_grpc_lib, "FLEXT-gRPC Library", "Python 3.13+", "Main library providing gRPC communication patterns")
    Container(flext_grpc_config, "Configuration System", "YAML/TOML/JSON", "Configuration management and validation")
    Container(flext_grpc_protobuf, "Protocol Buffers", "Protobuf 3", "Generated message and service definitions")
}

System_Boundary(flext_runtime, "FLEXT Runtime Environment") {
    Container(flext_core, "FLEXT-Core", "Python Library", "Foundation patterns: r, FlextContainer")
    Container(flext_observability, "FLEXT-Observability", "Python Library", "Metrics, tracing, and monitoring")
    Container(flext_cli, "FLEXT-CLI", "Python Library", "Command-line interface and diagnostics")
}

System_Ext(grpc_infrastructure, "gRPC Infrastructure", "grpcio/protobuf runtime")
System_Ext(python_runtime, "Python Runtime", "Python 3.13+ interpreter")
System_Ext(monitoring_stack, "Monitoring Stack", "Prometheus, Grafana")
System_Ext(service_registry, "Service Registry", "Consul, etcd, Kubernetes DNS")

Rel(user, flext_grpc_lib, "Imports and uses", "Python API")

Rel(flext_grpc_lib, flext_grpc_config, "Reads", "Configuration files")
Rel(flext_grpc_lib, flext_grpc_protobuf, "Uses", "Generated message classes")

Rel(flext_grpc_lib, flext_core, "Depends on", "Railway patterns, containers")
Rel(flext_grpc_lib, flext_observability, "Integrates with", "Metrics collection")
Rel(flext_grpc_lib, flext_cli, "Used by", "CLI commands")

Rel(flext_grpc_lib, grpc_infrastructure, "Uses", "gRPC protocol implementation")
Rel(flext_grpc_lib, python_runtime, "Runs on", "Python interpreter")
Rel(flext_grpc_lib, monitoring_stack, "Exports to", "Prometheus metrics")
Rel(flext_grpc_lib, service_registry, "Registers with", "Service discovery")

@enduml
